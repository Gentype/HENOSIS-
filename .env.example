## Henosis — environment variables

# OpenRouter API key. Required for the AI generation endpoint to work.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Google OAuth (next-auth v5) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used by next-auth to sign JWTs / encrypt cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional. If unset, defaults to http://localhost:3000 in dev. In production
# set this to your deployed origin (e.g. https://henosis.app).
# NEXTAUTH_URL=http://localhost:3000

# --- Optional: Upstash Redis for serverless deploy (Vercel etc.) ---
# When both are present, the user/quota store uses Redis instead of the local
# data/users.json file. Vercel's "KV (Redis) Database" integration injects
# these automatically — just add the integration in the Vercel dashboard.
# https://upstash.com/ also provides them.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
